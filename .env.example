# Copy to .env and change the values:  cp .env.example .env
# Note: the passwords are only applied the first time each service starts with an empty volume.

# Keycloak admin console (http://localhost:8080)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# MariaDB
MARIADB_ROOT_PASSWORD=change-me
DB_USERNAME=churchmedia_app
DB_PASSWORD=change-me

# RabbitMQ (management UI at http://localhost:15672)
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=change-me

# Client secret for the 'indexing-app' client in the Keycloak realm 'Alive'
INDEXING_APP_CLIENT_SECRET=change-me

# Password of the demo users admin, editor, viewer and tester in the realm 'Alive'
KEYCLOAK_DEMO_PASSWORD=change-me

# Folder on the host holding the media files served by file-server (default: ./media)
#MEDIA_ROOT=/path/to/media

# Image tag of the applications (default: latest)
#IMAGE_TAG=latest

# Build the applications from source instead of pulling images (separator is ':' on Linux/macOS, ';' on Windows)
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
